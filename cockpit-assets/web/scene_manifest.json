  "opening_sequence": {
    "route": "ROUTE_Opening",
    "start_camera": "CAM_Opening_Start",
    "end_camera": "CAM_Opening_Hero",
    "camera_duration_s": 4.0,
    "camera_easing": "easeOutCubic",
    "timeline_s": {
      "wireframe_only": [
        0.0,
        2.6
      ],
      "reveal": [
        2.6,
        3.8
      ],
      "settled": 4.0
    },
    "steps": [
      "0.0-2.6 s: black background, white line render of luffor_cockpit_wire.glb, pixelated to 6 px blocks with flickering block noise; camera drifts along ROUTE_Opening.",
      "2.6-3.8 s: per-block threshold reveal (random block order, biased from screen centre outward) swaps wireframe for the lit scene; revealed blocks pass through a 1-bit ordered-dither monochrome stage before reaching full colour; pixel block size shrinks 6 px -> 1 px.",
      "4.0 s: camera lands exactly on CAM_Opening_Hero; interaction is enabled."
    ],
    "browser_post_processing": [
      "Line rendering of the wire GLB (LineSegments, white, depth-tested against the scene)",
      "Pixelation pass (block size uniform)",
      "Block-noise reveal mask (hash of block coordinate vs progress uniform)",
      "Luma -> 4x4 Bayer ordered dither for the monochrome stage",
      "Optional: subtle full-time dither/grain and bloom on emissive screens, sign and lighthouse lantern"
    ]
  }
